{
  "name": "scp-wiki-client",
  "version": "1.0.0",
  "description": "Open-source SCP Foundation Wiki PC Desktop Client (EN/CN dual-branch reader with tabs, batch offline cache, export, unified Wikidot login, and proxy support)",
  "license": "MIT",
  "author": "toydream525",
  "homepage": "https://github.com/toydream525/scp-archive-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/toydream525/scp-archive-desktop.git"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build:exe": "electron-builder --win portable"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.scparchive.desktop",
    "productName": "SCP Archive",
    "directories": {
      "buildResources": "build",
      "output": "release/20261124-v5"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "src/main/webview-preload.js"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "SCP Archive.exe"
    }
  }
}
